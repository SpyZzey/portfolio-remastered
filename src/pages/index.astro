---
import Hero from '../components/Hero/Hero.jsx';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar/Navbar';
import ProjectList from '../components/ProjectList/ProjectList';
import AboutMe from '../components/AboutMeSection/AboutMe.jsx';
import Contact from '../components/Contact/Contact.jsx';
import Spacer from '../components/Spacer/Spacer.jsx';
import Timeline from '../components/Timeline/Timeline.jsx';
import FunFact from '../components/FunFact/FunFact.jsx';
import { FUN_FACTS } from '../data/funFacts';
---

<Layout>
    <div id="home"></div>
    <Navbar />
    <main
        id="main-content"
        tabindex="-1">
        <Hero client:load />

        <div id="about-me"></div>
        <Spacer height={50} />
        <AboutMe client:load />

        <FunFact
            {...FUN_FACTS.about}
            variant="stacked"
            className="about-fun-fact-stacked"
        />
        <Spacer height={40} />

        <hr data-reveal="line" />

        <div id="projects"></div>
        <Spacer height={50} />
        <ProjectList client:load />

        <Spacer height={40} />
        <FunFact
            {...FUN_FACTS.euroskills}
            variant="stacked"
        />

        <div id="timeline"></div>
        <Spacer height={50} />
        <Timeline />

        <Spacer height={40} />
        <FunFact
            {...FUN_FACTS.juniorStudies}
            variant="stacked"
        />

        <div id="contact"></div>
        <Spacer height={30} />
        <hr data-reveal="line" />
        <Spacer height={50} />
        <Contact />
    </main>
    <Spacer height={100} />
</Layout>
