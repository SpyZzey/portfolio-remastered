---
import './global.css';
import { ViewTransitions } from 'astro:transitions';
import Footer from '../components/Footer/Footer.jsx';

const { title = 'Simon Brebeck - Software Developer' } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <ViewTransitions />
        <script is:inline>
            // Returning to a project card: show the page in place instead of replaying entrance animations
            if (location.hash.startsWith('#project-'))
                document.documentElement.classList.add('skip-entrance');
        </script>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        />
        <meta
            name="description"
            content="Simon Brebeck - Software Developer from Germany. Specialized in Spring Boot, Angular, React, and full-stack development."
        />
        <meta
            name="author"
            content="Simon Brebeck"
        />
        <meta
            name="robots"
            content="index, follow"
        />
        <meta
            name="viewport"
            content="width=device-width"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="/favicon.webp"
        />
        <meta
            name="generator"
            content={Astro.generator}
        />

        <!-- Canonical URL -->
        <link
            rel="canonical"
            href="https://yourdomain.com/"
        />

        <!-- Favicon -->
        <link
            rel="icon"
            type="image/webp"
            href="/favicon.webp"
        />

        <!-- Open Graph (Facebook, LinkedIn) -->
        <meta
            property="og:title"
            content="Simon Brebeck - Software Developer"
        />
        <meta
            property="og:description"
            content="Portfolio of Simon Brebeck - Full-Stack Developer specialized in Spring Boot, Angular, React."
        />
        <meta
            property="og:type"
            content="website"
        />
        <meta
            property="og:url"
            content="https://simonbrebeck.de/"
        />
        <meta
            property="og:image"
            content="https://simonbrebeck.de/og-image.png"
        />

        <!-- Twitter Card -->
        <meta
            name="twitter:card"
            content="summary_large_image"
        />
        <meta
            name="twitter:title"
            content="Simon Brebeck - Software Developer"
        />
        <meta
            name="twitter:description"
            content="Full-Stack Developer from Germany building scalable backend systems and modern web applications."
        />
        <meta
            name="twitter:image"
            content="https://simonbrebeck.de/og-image.png"
        />

        <link
            rel="preconnect"
            href="https://fonts.googleapis.com"
        />
        <link
            rel="preconnect"
            href="https://fonts.gstatic.com"
            crossorigin
        />
        <!-- Instrument Sans for all text, Caveat for the handwritten note in the hero -->
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400..700&family=Caveat:wght@600&display=swap"
        />
        <title>{title}</title>
    </head>
    <body>
        <a
            class="skip-link"
            href="#main-content"
            >Skip to main content</a
        >
        <slot />
        <Footer />
        <!-- <div class="cursor-ring"></div> -->
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        /*cursor: none;*/
    }

    /* Keeps the footer at the bottom of the window on short pages */
    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }
    body > :global(footer) {
        margin-top: auto;
    }
    body:has(button:hover, a:hover) > .cursor-ring {
        width: 24px;
        height: 24px;
        border-color: #029d8b;
        &.clicking {
            background: rgb(1, 83, 73);

            width: 16px;
            height: 16px;
        }
    }

    .cursor-ring {
        pointer-events: none;
        position: fixed;
        width: 20px;

        height: 20px;
        border: 3px solid #8c40eb;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition:
            width 0.15s ease,
            height 0.15s ease,
            background 0.2s ease,
            border-color 0.2s ease;
        z-index: 10000;
        background-color: #000d0b;
    }

    /* Click Fill Animation */
    .cursor-ring.clicking {
        background: rgb(69, 38, 122);
        width: 16px;
        height: 16px;
        z-index: 10000;
    }
</style>
<script>
