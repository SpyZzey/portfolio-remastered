<script>
    // Reveal-on-scroll for elements with data-reveal (styles in global.css).
    // A MutationObserver picks up elements rendered later, e.g. client:only islands or "Show more".
    // Elements inside a React island are only marked once it has hydrated (Astro removes its `ssr`
    // attribute then), otherwise React reports the added attribute as a hydration mismatch.
    let revealObserver: IntersectionObserver | undefined;
    let mutationObserver: MutationObserver | undefined;

    const isHydrating = (element: Element) => element.closest('astro-island[ssr]') !== null;

    const observeReveal = (element: Element) => {
        if (!isHydrating(element)) revealObserver?.observe(element);
    };

    const observeReveals = (root: ParentNode) => {
        root.querySelectorAll('[data-reveal]:not([data-revealed])').forEach(observeReveal);
    };

    document.addEventListener('astro:page-load', () => {
        revealObserver?.disconnect();
        mutationObserver?.disconnect();

        revealObserver = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    entry.target.setAttribute('data-revealed', '');
                    revealObserver?.unobserve(entry.target);
                }
            },
            { threshold: 0.1 },
        );
        observeReveals(document);

        mutationObserver = new MutationObserver((mutations) => {
            for (const mutation of mutations) {
                // An island finished hydrating
                if (mutation.type === 'attributes') {
                    // React 19 finishes hydrating shortly after Astro drops the marker, so wait a moment
                    const island = mutation.target as Element;
                    if (!island.hasAttribute('ssr')) setTimeout(() => observeReveals(island), 150);
                    continue;
                }
                for (const node of mutation.addedNodes) {
                    if (!(node instanceof Element)) continue;
                    if (node.matches('[data-reveal]:not([data-revealed])')) observeReveal(node);
                    observeReveals(node);
                }
            }
        });
        mutationObserver.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['ssr'],
        });
    });
</script>
<script>
    // Page transition direction (animations in global.css).
    // Going back = browser back/forward or the "Back to projects" link. Going back skips the entrance
    // animations, and the card image/title don't morph: the page only scrolls to the card after the
    // transition has captured its end state, so they would fly towards the card's spot at the top.
    const TRANSITION_CLASSES = ['vt-forward', 'vt-back', 'no-image-morph'];
    let isReturning = false;

    const setTransitionClasses = (root: HTMLElement) => {
        root.classList.remove(...TRANSITION_CLASSES);
        root.classList.add(isReturning ? 'vt-back' : 'vt-forward');
        if (isReturning) root.classList.add('no-image-morph');
    };

    // Runs before the old page is captured, so the classes already apply to it
    document.addEventListener('astro:before-preparation', (event) => {
        isReturning = event.navigationType === 'traverse' || event.to.hash.startsWith('#project-');
        setTransitionClasses(document.documentElement);

        // Only the project being opened morphs. Everything else goes with the rest of the page,
        // e.g. the other project cards, or the lead image when leaving a project page.
        const openedProjectId = event.to.pathname.match(/^\/projects\/([^/]+)/)?.[1];
        const morphingNames = openedProjectId
            ? [`project-image-${openedProjectId}`, `project-title-${openedProjectId}`]
            : [];
        document
            .querySelectorAll<HTMLElement>(
                '.project-image, .project-card-title, .project-lead-image, .project-detail h1',
            )
            .forEach((element) => {
                if (!morphingNames.includes(element.style.viewTransitionName)) {
                    element.style.viewTransitionName = 'none';
                }
            });
    });

    // The new page's <html> attributes replace the current ones, so set the classes there too
    document.addEventListener('astro:before-swap', (event) => {
        const root = event.newDocument.documentElement;
        root.classList.toggle('skip-entrance', isReturning);
        setTransitionClasses(root);

        const cleanUp = () => document.documentElement.classList.remove(...TRANSITION_CLASSES);
        if (event.viewTransition) event.viewTransition.finished.finally(cleanUp);
        else document.addEventListener('astro:page-load', cleanUp, { once: true });
    });

    // Smooth scrolling is for in-page anchor links only. After a page change, jump straight to the
    // target (or restored position) instead of animating there from the top.
    document.addEventListener('astro:after-swap', () => {
        document.documentElement.style.scrollBehavior = 'auto';
    });
    document.addEventListener('astro:page-load', () => {
        requestAnimationFrame(() => document.documentElement.style.removeProperty('scroll-behavior'));
    });
</script>
<script>
    // Navbar: background once scrolled, hide while scrolling down, and highlight the current section.
    // Re-run on every page load because view transitions swap in a new navbar.
    let removeNavbarListener: (() => void) | undefined;

    document.addEventListener('astro:page-load', () => {
        removeNavbarListener?.();

        const navbar = document.querySelector<HTMLElement>('.navbar');
        if (!navbar) return;

        // Only the home page has the section anchors the links point to
        const sectionLinks = [...navbar.querySelectorAll<HTMLAnchorElement>('.navbar-links a')]
            .map((link) => ({ link, section: document.getElementById(link.hash.slice(1)) }))
            .filter(
                (entry): entry is { link: HTMLAnchorElement; section: HTMLElement } => entry.section !== null,
            );

        let lastScrollY = window.scrollY;
        let frameId: number | null = null;

        const update = () => {
            frameId = null;
            const scrollY = window.scrollY;

            navbar.classList.toggle('scrolled', scrollY > 0);

            // Ignore tiny jitters so the bar doesn't flicker; never hide it while the menu is open
            if (Math.abs(scrollY - lastScrollY) > 4) {
                const isMenuOpen = navbar.classList.contains('navbar--menu-open');
                navbar.classList.toggle(
                    'navbar--hidden',
                    !isMenuOpen && scrollY > 160 && scrollY > lastScrollY,
                );
                lastScrollY = scrollY;
            }

            // The current section is the last one whose anchor has passed 40% of the viewport
            const current = sectionLinks
                .filter(({ section }) => section.getBoundingClientRect().top < window.innerHeight * 0.4)
                .at(-1);
            for (const { link } of sectionLinks) {
                if (link === current?.link) link.setAttribute('aria-current', 'true');
                else link.removeAttribute('aria-current');
            }
        };

        const onScroll = () => {
            frameId ??= requestAnimationFrame(update);
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        update();

        // Small screens: the menu button opens the links as a panel below the bar
        const menuButton = navbar.querySelector<HTMLButtonElement>('.navbar-menu-button');
        const isMenuOpen = () => navbar.classList.contains('navbar--menu-open');
        const setMenuOpen = (open: boolean) => {
            navbar.classList.toggle('navbar--menu-open', open);
            menuButton?.setAttribute('aria-expanded', String(open));
        };

        menuButton?.addEventListener('click', () => setMenuOpen(!isMenuOpen()));
        navbar
            .querySelectorAll('.navbar-links a')
            .forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

        const onKeyDown = (event: KeyboardEvent) => {
            if (event.key !== 'Escape' || !isMenuOpen()) return;
            setMenuOpen(false);
            menuButton?.focus();
        };
        const onPointerDown = (event: PointerEvent) => {
            if (isMenuOpen() && !navbar.contains(event.target as Node)) setMenuOpen(false);
        };
        // Widening the window past the breakpoint shows the inline links again
        const wideScreen = window.matchMedia('(min-width: 560px)');
        const onWideScreen = () => {
            if (wideScreen.matches) setMenuOpen(false);
        };

        document.addEventListener('keydown', onKeyDown);
        document.addEventListener('pointerdown', onPointerDown);
        wideScreen.addEventListener('change', onWideScreen);

        removeNavbarListener = () => {
            window.removeEventListener('scroll', onScroll);
            if (frameId !== null) cancelAnimationFrame(frameId);
            document.removeEventListener('keydown', onKeyDown);
            document.removeEventListener('pointerdown', onPointerDown);
            wideScreen.removeEventListener('change', onWideScreen);
        };
    });
</script>
