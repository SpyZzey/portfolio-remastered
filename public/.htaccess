# Enable rewriting
RewriteEngine On

# Set base (change if app is in subfolder)
RewriteBase /

# If request is a real file or directory — serve it
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise return 404 and serve /404.html
RewriteRule ^ /404.html [L,R=404]

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html